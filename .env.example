# Vorlage fuer die lokale `.env`. Kopieren und fuellen:
#
#   cp .env.example .env
#
# Die Platzhalter unten sind absichtlich unbrauchbar. Der Server prueft beide
# Geheimnisse und BASIS_URL beim Laden und bricht mit einer benannten
# Beanstandung ab — beim Produktionsstart (node dist/apps/jufi/server/server.mjs)
# ebenso wie unter `pnpm run dev`. Mit dieser Datei, wie sie hier steht, startet
# also keins von beiden; erst die Geheimnisse eintragen.

DATABASE_URL="postgresql://jufi:jufi_dev_only@127.0.0.1:5433/jufi?schema=public"

# Verbindung zum Server ohne Datenbank: Die Tests legen darueber ihre eigenen
# Datenbanken jufi_test_<projekt> an und setzen sie zurueck.
TEST_DATABASE_HOST_URL="postgresql://jufi:jufi_dev_only@127.0.0.1:5433/postgres"

# Signiert Sitzungen und die Anmelde-Zwischenmarke. Mindestens 32 Zeichen:
#   openssl rand -base64 32
SESSION_SECRET=""

# Verschluesselt das TOTP-Geheimnis in der Datenbank. Muss **genau** 32 Byte
# base64 sein — 31 oder 33 lehnt der Start ab:
#   openssl rand -base64 32
TOTP_ENC_KEY=""

# Wo die App von aussen erreichbar ist; steht in Links in Mails.
BASIS_URL="http://localhost:4200"

# --- Passkeys (WebAuthn) -----------------------------------------------------
# Beides darf lokal leer bleiben: ohne die Variablen leitet der Server rpId und
# Ursprung aus dem Host-Header ab, und `localhost` gilt fuer WebAuthn als sicher.
#
# In Produktion stehen sie **ausdruecklich**, damit nicht ein Header entscheidet,
# woran ein Schluessel haengt. Achtung: die rpId ist die Domain ohne Port, der
# Ursprung enthaelt Schema und Port. Und ein Wechsel der Domain macht alle
# bestehenden Passkeys wertlos — sie sind daran gebunden.
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGIN=""

# --- Mail --------------------------------------------------------------------
# Lokal faengt Mailpit alles ab (docker-compose.dev.yml, Weboberflaeche auf
# http://127.0.0.1:8025). Diese Werte liest der Mail-Arbeiter (Einladung und
# Zurücksetzen), der im Serverprozess läuft.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
MAIL_ABSENDER="app@jufi-app.de"
MAIL_ANTWORT="kontakt@jufi-app.de"
# Steht vor jedem Betreff, damit eine Mail aus der Entwicklung nie wie eine
# echte aussieht.
MAIL_BETREFF_PRAEFIX="[Lokal] "
