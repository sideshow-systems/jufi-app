{
  "name": "@jufi/source",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "//packageManager": "Gepinnt, damit corepack im Docker-Build dieselbe pnpm-Version nimmt wie lokal (Erfahrung aus HWYD: ohne das Feld zieht corepack die neueste).",
  "packageManager": "pnpm@10.34.5",
  "//scripts": "deploy:app und nicht deploy: pnpm deploy ist pnpms eingebautes Workspace-Deploy, und wer das run vergaesse, loeste jenes statt dieses Skripts aus. Probelauf: pnpm run deploy:app --dry-run. image:app baut dasselbe Image ohne Tore als jufi:local, zum Anprobieren von Hand.",
  "scripts": {
    "dev": "pnpm run db:up && nx serve jufi",
    "dev:entwurf": "nx serve entwurf",
    "build:entwurf": "nx build entwurf",
    "test": "nx run-many -t test test-server",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx run jufi-e2e:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "image:entwurf": "docker build -f Dockerfile.entwurf -t jufi-entwurf:local .",
    "deploy:entwurf": "bash tools/deploy-entwurf.sh",
    "image:app": "docker build -t jufi:local --build-arg APP_VERSION=$(node -p \"require('./package.json').version\") --build-arg GIT_COMMIT=$(git rev-parse HEAD) .",
    "deploy:app": "bash tools/deploy.sh",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:psql": "docker exec -it jufi-postgres-dev psql -U jufi -d jufi",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "cli": "nx build cli && node apps/cli/dist/main.js",
    "demo": "pnpm run cli demo einspielen"
  },
  "nx": {
    "//": "Leere Liste: die Skripte hier sind Abkuerzungen fuer den Menschen. Ohne das wuerde Nx sie als Targets eines Root-Projekts erkennen, und `pnpm test` (nx run-many -t test) wuerde sich selbst aufrufen.",
    "includedScripts": []
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.0.4",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/build": "~22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/compiler-cli": "~22.0.4",
    "@nx/angular": "23.1.0",
    "@nx/esbuild": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "~22.0.4",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "~4.1.11",
    "esbuild": "^0.27.7",
    "jsdom": "^27.1.0",
    "nx": "23.1.0",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@angular/common": "~22.0.4",
    "@angular/compiler": "~22.0.4",
    "@angular/core": "~22.0.4",
    "@angular/forms": "~22.0.4",
    "@angular/platform-browser": "~22.0.4",
    "@angular/platform-server": "~22.0.8",
    "@angular/router": "~22.0.4",
    "@angular/ssr": "~22.0.9",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^4.22.3",
    "lucide": "^1.31.0",
    "marked": "^18.1.1",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
