{
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": true,
	"printWidth": 120,
	"overrides": [
		{
			"comment": "YAML verbietet Tabs zur Einrückung (Spezifikation). Ein Tab hier ist ein Parser-Fehler, kein Stilverstoß.",
			"files": ["*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		},
		{
			"comment": "package.json wird von pnpm beim Schreiben ohnehin auf Spaces normalisiert.",
			"files": ["package.json"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
