{
  "name": "@jufi/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "cli",
    "targets": {
      "test": {
        "//": "Echte Datenbank: Das Ergebnis haengt vom Zustand der Datenbank und von den Migrationen ab, nicht nur von Dateien dieses Projekts. Zwischengespeichert wuerde ein Lauf als bestanden gelten, ohne dass eine neue Migration je gegen eine frische Datenbank lief. prisma/ steht zusaetzlich in sharedGlobals (nx.json), damit auch der Hash der uebrigen Ziele (typecheck, build) Schemaaenderungen sieht. Gleiche Entscheidung wie bei jufi:test-server. Offen: die vom Plugin erzeugten test-ci--Ziele sind noch zwischengespeichert; vor dem Einrichten von CI nachziehen.",
        "cache": false
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/cli/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/cli/src/main.ts",
          "tsConfig": "apps/cli/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          },
          "external": [
            "@prisma/client",
            "@prisma/adapter-pg",
            "pg",
            "@node-rs/argon2"
          ]
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@jufi/auth": "workspace:*",
    "@jufi/db": "workspace:*",
    "@jufi/domain": "workspace:*"
  }
}
