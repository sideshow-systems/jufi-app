# Von tools/entwurf-konfig.mjs bei jedem Bau geschrieben. Enthaelt die
# WhatsApp-Nummer fuer Rueckmeldungen, die nicht ins Repo gehoert (Spec TP1 5.5).
apps/entwurf/src/konfig.generated.ts

