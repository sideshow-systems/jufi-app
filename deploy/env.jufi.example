# JuFi-Variablen fuer die **gemeinsame** `.env` auf dem Server
# (/home/paperless/paperless-ngx/.env). Gelesen von deploy/jufi-services.yml.
#
# Diese Zeilen werden dort angehaengt, nicht ersetzt: in derselben Datei stehen
# schon die Zugaenge von paperless, HWYD und den anderen Apps. Deshalb tragen
# alle JuFi-Werte das Praefix `JUFI_` -- ein allgemeines SESSION_SECRET
# kollidierte mit dem einer anderen App.
#
# **Die Werte werden auf dem Server erzeugt, nicht hier eingetragen.** Ein
# Geheimnis, das durch eine Zwischenablage, ein Protokoll oder eine Chatsitzung
# laeuft, ist keins:
#
#   cd /home/paperless/paperless-ngx
#   {
#     echo "JUFI_POSTGRES_USER=jufi"
#     echo "JUFI_POSTGRES_DB=jufi"
#     echo "JUFI_POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=')"
#     echo "JUFI_SESSION_SECRET=$(openssl rand -base64 32)"
#     echo "JUFI_TOTP_ENC_KEY=$(openssl rand -base64 32)"
#     echo "JUFI_IMAGE_TAG=latest"
#   } >> .env
#
# tools/deploy.sh prueft vor jedem Ausrollen, dass alle Zeilen da und nicht leer
# sind (es nennt nur die Namen, nie Werte), und legt selbst keine an.

JUFI_POSTGRES_USER=
JUFI_POSTGRES_DB=

# Im Passwort keine Zeichen, die in einer URL eine Bedeutung haben -- es landet
# in DATABASE_URL. Deshalb oben `tr -d '/+='`.
JUFI_POSTGRES_PASSWORD=

# Signiert Sitzungen und die Anmelde-Zwischenmarke. Mindestens 32 Zeichen.
# Aendern meldet alle ab, sonst nichts.
JUFI_SESSION_SECRET=

# Verschluesselt das TOTP-Geheimnis in der Datenbank. Genau 32 Byte base64.
# **Darf nicht verloren gehen**: ohne diesen Wert ist der zweite Faktor nicht
# mehr entschluesselbar, und jeder mit TOTP muss neu eingerichtet werden (Admins
# per `node apps/cli/dist/main.js admin zuruecksetzen <name>`).
# Gehoert in den Passwortmanager, nicht nur auf den Server.
JUFI_TOTP_ENC_KEY=

# Welches Image laeuft. tools/deploy.sh setzt das auf den Git-SHA; ein Rueckfall
# auf die Vorversion ist damit ein Tag-Wechsel und ein `up -d jufi`. Die Zeile
# muss existieren -- das Skript ersetzt sie nur.
JUFI_IMAGE_TAG=latest
