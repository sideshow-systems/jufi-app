# Vorlage fuer `.env.deploy` im Projektwurzelverzeichnis. Die Datei liegt in
# .gitignore: Serveradresse und WhatsApp-Nummer gehoeren nicht ins Repo.
#
#   cp deploy/env.deploy.example .env.deploy

# Zugang zum Server. Der Schluessel wird ausdruecklich genannt, damit der Deploy
# nicht davon abhaengt, was im ssh-agent gerade geladen ist.
SSH_TARGET=
SSH_KEY=

# Der Entwurf wohnt in der gemeinsamen Compose-Datei von paperless.
REMOTE_DIR=/home/paperless/paperless-ngx

# Nummer fuer Rueckmeldungen aus dem Testmodus, international ohne +
# (z. B. 4917012345678). Wird beim Bau ins Buendel geschrieben und ist dort
# lesbar (Spec TP1 5.5). Leer: der Entwurf faellt auf Teilen bzw. Kopieren zurueck.
JUFI_ENTWURF_WHATSAPP=
