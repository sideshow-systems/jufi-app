# Klickbarer Entwurf (Teilprojekt 1) als statisches nginx-Image.
#
# Kein Node im Image: `pnpm nx build entwurf` laeuft vorher lokal
# (tools/deploy-entwurf.sh), hier wird nur das fertige Buendel kopiert. Rechner
# und Server sind beide arm64, der Bau ist also nativ (Spec TP1 8.3).
#
#   pnpm nx build entwurf && docker build -f Dockerfile.entwurf -t jufi-entwurf:local .
FROM nginx:alpine

ARG GIT_COMMIT=unbekannt
LABEL org.opencontainers.image.title="jufi-entwurf" \
	org.opencontainers.image.description="Klickbarer Entwurf der JuFi App" \
	org.opencontainers.image.revision="${GIT_COMMIT}"

COPY deploy/nginx-entwurf.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-sicherheit.conf /etc/nginx/sicherheit.conf
COPY dist/apps/entwurf/browser /usr/share/nginx/html/entwurf
# nginx:alpine bringt eine Willkommensseite als index.html mit, und die
# Wurzel / lieferte sie mit 200. Seit Etappe 6 gehoert / der echten App; der
# Entwurf soll dort nichts ausliefern (nginx antwortet ohne index.html 403,
# das Verzeichnis darf nicht aufgelistet werden; Gegenprobe im Rauchtest von
# tools/deploy-entwurf.sh). Verworfen: ein location-Block mit return 404 in
# der nginx-Konfiguration -- eine Regel mehr, wo das Entfernen der Datei genuegt.
RUN rm -f /usr/share/nginx/html/index.html /usr/share/nginx/html/50x.html

# busybox-wget steckt in alpine; Traefik nimmt den Dienst erst bei "healthy" auf.
# In der Startphase jede Sekunde pruefen: sonst wartet Traefik nach jedem
# Ausrollen bis zu 30 s auf die erste Pruefung, und die Seite fehlt so lange.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 --start-period=10s --start-interval=1s \
	CMD wget -q -O /dev/null http://127.0.0.1/entwurf/ || exit 1
