// JuFi App — Datenmodell. Siehe Spezifikation TP2 Fundament, Abschnitt 3.
//
// Mandantentrennung (Spec 3.1): Jede Vereinstabelle traegt vereinId, auch die
// Verknuepfungstabellen. Verweise auf Personen und Zugaenge laufen ueber das Paar
// (vereinId, id) als zusammengesetzten Fremdschluessel. So kann die Datenbank
// selbst keine Familie, Untergruppe oder Sitzung ueber Vereinsgrenzen hinweg
// verknuepfen. Verworfen: Schutz nur in der Datenschicht (vereinDb) — ein
// einziger Fehler im Code waere dann ein Leck. Dass vereinId dabei in mehreren
// Relationen eines Modells steckt, ist gewollt.
//
// Alle zusammengesetzten Relationen tragen onUpdate: NoAction. Damit ist die
// vereinId einer Person, Untergruppe oder eines Zugangs praktisch unveraenderlich,
// sobald etwas auf die Zeile verweist — zweiter Riegel neben vereinDb. Verworfen:
// Prismas Vorgabe Cascade — ein update von Person.vereinId zoege Zugang, Passkeys
// und Sitzungen still in einen anderen Verein mit.
//
// CHECK-Constraints und Partial-Unique-Indizes bildet Prisma nicht ab; sie stehen
// von Hand am Ende der Migrationen fundament, email_an_person und threads
// (prisma/migrations/).
//
// Hinweis: `prisma format` schreibt feste zwei Spaces und ist nicht
// konfigurierbar — daher weicht diese Datei bewusst von der Tab-Regel ab.

generator client {
  provider     = "prisma-client"
  output       = "../libs/db/src/generated"
  moduleFormat = "esm"
}

// Prisma 7: `url` ist im Schema nicht mehr erlaubt. Die Verbindung fuer Migrate
// steht in prisma.config.ts, der Client bekommt einen Driver Adapter.
datasource db {
  provider = "postgresql"
}

// --- Enums --------------------------------------------------------------------

enum VereinStatus {
  AKTIV
  /// Alle Seiten des Vereins "nicht gefunden"; Sitzungen bleiben bestehen und
  /// wirken nach dem Entsperren wieder (Spec 7.3).
  GESPERRT
}

enum PersonArt {
  JUNGFISCHER
  ERWACHSENER
}

/// Rechte nach Rahmen-Spec 4.2. Auch Rechte fuer Bereiche, die erst spaeter
/// entstehen, lassen sich schon in TP2 vergeben.
enum Recht {
  MITGLIEDER
  THREADS_ERSTELLEN
  ALLE_THREADS
  DOKUMENTE
  ANTWORTEN_DETAIL
  JUGENDLEITER_RECHTE
  EINSTELLUNGEN
}

enum Beziehung {
  MUTTER
  VATER
  GROSSMUTTER
  GROSSVATER
  TANTE
  ONKEL
  GESCHWISTER
  PFLEGEPERSON
  ANDERE
}

enum EinladungArt {
  EINLADUNG
  RESET
}

/// DSGVO_ART8 oeffnet dem Kind den Zugang zur App, FOTOS erlaubt nur, es auf Fotos
/// zu zeigen (TP4 Etappe 2, Entscheidung 8). Jede Abfrage nennt die Art, die sie meint;
/// die eine ersetzt die andere nicht, und der Widerruf der einen zieht die andere nicht mit.
enum EinwilligungArt {
  DSGVO_ART8
  FOTOS
}

/// Was im AdminProtokoll steht (Spec 7.5). Loeschen eines Vereins fehlt bewusst:
/// es geschieht nur ueber die Kommandozeile, nicht als angemeldeter Admin.
enum AdminAktion {
  VEREIN_ANGELEGT
  GESPERRT
  ENTSPERRT
  SLUG_KORRIGIERT
  NOTFALL_LINK
  ERSTE_EINLADUNG_ERNEUERT
  SPEICHERGRENZE
}

/// Der Jugendsprecher-Austausch ist der eine Thread je Verein, den das System
/// anlegt (TP3-Spec 2.1); alle anderen legen Jugendleiter an.
enum ThreadArt {
  NORMAL
  JUGENDSPRECHER_AUSTAUSCH
}

enum ThreadModus {
  AUSHANG
  KOMMENTARE
  CHAT
}

enum Rollenfilter {
  JUNGFISCHER_FAMILIE
  NUR_FAMILIE
  NUR_JUGENDLEITER
  JUGENDLEITER_JUGENDSPRECHER
}

enum ArchivModus {
  AUTOMATISCH
  ARCHIVIERT
  AKTIV_HALTEN
}

/// Teilprojekt 4 ergaenzt weitere Typen (Etappe 2: DATEIEN, FOTOS).
enum ModulTyp {
  INFO
  TERMIN
  UMFRAGE
  DATEIEN
  FOTOS
  HELFER
}

/// Wer in ein Foto-Modul hochladen darf (TP4-Spec). Dieselben Werte wie
/// FotoHochladen in libs/domain/src/threads/rechte.ts.
enum FotoHochladen {
  JUGENDLEITER
  ALLE
}

enum AntwortEinheit {
  JUNGFISCHER
  ERWACHSENER
  PERSON
}

enum ErgebnisSicht {
  ALLE
  SUMME
  JUGENDLEITER
}

enum VerlaufArt {
  NACHRICHT
  SYSTEM
}

enum SystemArt {
  VEROEFFENTLICHT
  TERMIN_GEAENDERT
  FRIST_GEAENDERT
  MODUS_GEAENDERT
}

enum AenderungArt {
  THREAD
  MODUL
  ANTWORT
  VERLAUF
  SICHTBARKEIT
  GELOESCHT
  /// Anpinnen und Archivieren: aendert die Liste, ist aber keine Aktivitaet im Thread.
  LISTE
}

// --- Verein -------------------------------------------------------------------

model Verein {
  id               String       @id @default(cuid())
  /// Kleinbuchstaben, Ziffern, Bindestriche, 3–30 Zeichen (CHECK verein_slug).
  /// Reservierte Slugs prueft libs/domain; die Liste waechst mit den Routen und
  /// gehoert deshalb nicht in einen CHECK.
  slug             String       @unique
  /// Offizieller Name, z.B. fuer Einwilligungstext, Kontakt, Fusszeile der Mails.
  name             String
  /// Hoechstens 24 Zeichen (CHECK verein_anzeigename): Kopfzeile, Passkey-Name,
  /// Home-Bildschirm, Betreff der Mails.
  anzeigename      String
  /// Vereinsfarbe als Hex-Wert; alles Weitere wird daraus abgeleitet.
  farbe            String
  /// Freitext. Optional, weil "Verein anlegen" (Spec 7.3) ihn nicht abfragt.
  kontakt          String?
  status           VereinStatus @default(AKTIV)
  angelegtAm       DateTime     @default(now())
  /// Zaehler nur zum Sperren: Wer ihn erhoeht, haelt die Vereinszeile bis zum Ende
  /// seiner Transaktion; parallele Anmeldungen und Einloesungen im selben Verein
  /// laufen dadurch nacheinander. Gewaehlt statt SELECT ... FOR UPDATE (Roh-SQL ist in
  /// vereinDb gesperrt) und statt Advisory Locks (haengen an Verbindungen, nicht an Zeilen).
  sperrzaehler     Int          @default(0)
  /// Zaehler der Aenderungen im Verein (TP3-Spec 2.6). Jede schreibende
  /// Transaktion erhoeht ihn genau einmal und haelt dadurch die Vereinszeile bis
  /// zum Ende: Gleichzeitige Schreiber vergeben nacheinander lueckenlose Staende,
  /// und eine zurueckgerollte Transaktion verbraucht keinen. Ein Stand je
  /// Transaktion, nicht je Zeile, damit eine Arbeit (Verlaufseintrag plus
  /// Thread-Aktivitaet) einen gemeinsamen Stand traegt. Int statt BigInt: 2,1
  /// Milliarden Aenderungen je Verein werden nie erreicht, und BigInt braeche
  /// JSON.stringify an jeder API-Grenze.
  aenderungsstand  Int          @default(0)
  /// Speichergrenze der Dateien in MB (CHECK verein_speichergrenze, 100 bis 1048576); der
  /// Plattform-Admin aendert sie. Int statt BigInt aus demselben Grund wie
  /// aenderungsstand: BigInt braeche JSON.stringify an der API-Grenze, und selbst die
  /// Obergrenze von 1 TB passt in MB in 32 Bit.
  speicherGrenzeMb Int          @default(5120)

  logo                   VereinLogo?
  personen               Person[]
  bezugspersonen         Bezugsperson[]
  untergruppen           Untergruppe[]
  untergruppeMitglieder  UntergruppeMitglied[]
  zugaenge               Zugang[]
  passkeys               Passkey[]
  recoveryCodes          RecoveryCode[]
  sessions               Session[]
  webauthnChallenges     WebauthnChallenge[]
  einladungen            Einladung[]
  einwilligungen         Einwilligung[]
  mails                  MailWarteschlange[]
  threads                Thread[]
  threadUntergruppen     ThreadUntergruppe[]
  threadModule           ThreadModul[]
  infoModule             InfoModul[]
  dateienModule          DateienModul[]
  fotosModule            FotosModul[]
  terminModule           TerminModul[]
  umfrageModule          UmfrageModul[]
  umfrageOptionen        UmfrageOption[]
  umfrageAntworten       UmfrageAntwort[]
  umfrageAntwortOptionen UmfrageAntwortOption[]
  helferModule           HelferModul[]
  helferPositionen       HelferPosition[]
  helferEintraege        HelferEintrag[]
  verlauf                VerlaufEintrag[]
  gelesenStaende         GelesenStand[]
  aenderungen            Aenderung[]
  dateien                Datei[]
  kategorien             DokumentKategorie[]
  dokumente              Dokument[]
}

/// Eigene Tabelle, damit nicht jede Vereinsabfrage das Bild mitlaedt. Verworfen:
/// Dateiablage im Volume — die entsteht erst in TP4, und so ist das Logo mit der
/// Datenbank gesichert (Spec 3.2).
model VereinLogo {
  vereinId    String   @id
  verein      Verein   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  /// PNG oder JPEG, hoechstens 1 MB.
  bild        Bytes
  mimeType    String
  icon192     Bytes
  icon512     Bytes
  geaendertAm DateTime @default(now()) @updatedAt
}

// --- Personen -----------------------------------------------------------------

/// Jungfischer und Erwachsene in einer Tabelle. Welche Felder zur Art passen,
/// prueft libs/domain; der CHECK person_art_felder sichert es zusaetzlich ab.
///
/// Entfernte Personen bleiben als Grabstein (Spec 5.8): Namen und Geburtsdatum
/// geleert, Rechte geleert, entferntAm gesetzt. Spaetere Antworten verweisen
/// weiter auf die Zeile.
model Person {
  id                    String    @id @default(cuid())
  vereinId              String
  verein                Verein    @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  art                   PersonArt
  /// Leer bei Grabstein.
  vorname               String
  /// Leer bei Grabstein.
  nachname              String
  /// Nur Jungfischer, dort Pflicht ausser beim Grabstein.
  geburtsdatum          DateTime? @db.Date
  /// Nur Jungfischer (Rahmen-Spec 3.5).
  jugendsprecher        Boolean   @default(false)
  /// Nur bei Jungfischern bedeutsam; Erziehungsberechtigte entscheiden.
  zugangErlaubt         Boolean   @default(true)
  /// Nur Jungfischer: Verwaltung hat den Volljaehrigkeitshinweis mit "Belassen"
  /// quittiert (Spec 5.6).
  volljaehrigGeprueftAm DateTime?
  /// Kleingeschrieben und ohne Rand (CHECK person_email), eindeutig je Verein.
  /// Erwachsene: ihre Kennung; beim Anlegen freiwillig, spaetestens beim Annehmen
  /// der Einladung Pflicht (das prueft libs/domain, nicht die Datenbank).
  /// Jungfischer: freiwillig, nur fuer Benachrichtigungen ab TP5. An der Person und
  /// nicht am Zugang, weil Einladung, erste Leitung und Ansprechpartner die Adresse
  /// brauchen, bevor es einen Zugang gibt. Verworfen: eine zweite Kopie am Zugang
  /// -- zwei Adressen liefen auseinander.
  email                 String?
  /// Nur Erwachsene; leer = kein Jugendleiter. NOT NULL steht von Hand in der
  /// Migration email_an_person: Prisma legt Listenfelder ohne an.
  rechte                Recht[]   @default([])
  /// Gesetzt = Grabstein.
  entferntAm            DateTime?
  angelegtAm            DateTime  @default(now())

  zugang                       Zugang?
  alsErwachsener               Bezugsperson[]        @relation("BezugspersonErwachsener")
  alsJungfischer               Bezugsperson[]        @relation("BezugspersonJungfischer")
  untergruppen                 UntergruppeMitglied[]
  einladungen                  Einladung[]           @relation("EinladungPerson")
  erstellteEinladungen         Einladung[]           @relation("EinladungErstelltVon")
  einwilligungenAlsJungfischer Einwilligung[]        @relation("EinwilligungJungfischer")
  erteilteEinwilligungen       Einwilligung[]        @relation("EinwilligungErteiltVon")
  webauthnChallenges           WebauthnChallenge[]
  erstellteThreads             Thread[]              @relation("ThreadErstelltVon")
  antwortenFuer                UmfrageAntwort[]      @relation("AntwortFuer")
  antwortenVon                 UmfrageAntwort[]      @relation("AntwortVon")
  helferEintraegeFuer          HelferEintrag[]       @relation("HelferEintragFuer")
  helferEintraegeVon           HelferEintrag[]       @relation("HelferEintragVon")
  verlaufAlsAutor              VerlaufEintrag[]      @relation("VerlaufAutor")
  verlaufGeloescht             VerlaufEintrag[]      @relation("VerlaufGeloeschtVon")
  gelesenStaende               GelesenStand[]
  hochgeladeneDateien          Datei[]               @relation("DateiVon")

  /// Ziel der zusammengesetzten Fremdschluessel (Spec 3.1).
  @@unique([vereinId, id])
  /// Je Verein, nicht global: Wer in zwei Vereinen ist, hat in jedem eine eigene
  /// Person, gern mit derselben Adresse (Spec 4.2, Passkey-Name).
  @@unique([vereinId, email])
  @@index([vereinId, art])
}

/// Familienzuordnung zwischen einem Erwachsenen und einem Jungfischer.
model Bezugsperson {
  id                   String    @id @default(cuid())
  vereinId             String
  verein               Verein    @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  erwachsenerId        String
  erwachsener          Person    @relation("BezugspersonErwachsener", fields: [vereinId, erwachsenerId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  jungfischerId        String
  jungfischer          Person    @relation("BezugspersonJungfischer", fields: [vereinId, jungfischerId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  beziehung            Beziehung
  /// Nur bei ANDERE, dort Pflicht (CHECK bezugsperson_freitext).
  beziehungFreitext    String?
  /// Wirkt nur bis zur Volljaehrigkeit des Jungfischers (Spec 5.6); das prueft
  /// libs/domain, die Spalte haelt nur die Angabe der Verwaltung.
  erziehungsberechtigt Boolean
  angelegtAm           DateTime  @default(now())

  @@unique([erwachsenerId, jungfischerId])
  @@index([vereinId, erwachsenerId])
  @@index([vereinId, jungfischerId])
}

model Untergruppe {
  id         String   @id @default(cuid())
  vereinId   String
  verein     Verein   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  name       String
  angelegtAm DateTime @default(now())

  mitglieder UntergruppeMitglied[]
  threads    ThreadUntergruppe[]

  @@unique([vereinId, name])
  @@unique([vereinId, id])
}

/// Nur Jungfischer. Das prueft libs/domain; ein Fremdschluessel kann die Art der
/// Person nicht sehen.
model UntergruppeMitglied {
  vereinId      String
  verein        Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  untergruppeId String
  untergruppe   Untergruppe @relation(fields: [vereinId, untergruppeId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  personId      String
  person        Person      @relation(fields: [vereinId, personId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([untergruppeId, personId])
  @@index([vereinId, personId])
}

// --- Zugang und Anmeldung -----------------------------------------------------

/// 0..1 je Person. Entsteht erst beim Einloesen der Einladung, zusammen mit dem
/// ersten Anmeldeweg — einen Zugang ohne Passkey und ohne Passwort gibt es nicht.
model Zugang {
  id                String    @id @default(cuid())
  vereinId          String
  verein            Verein    @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  personId          String    @unique
  person            Person    @relation(fields: [vereinId, personId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Kleingeschrieben, eindeutig je Verein; nur Jungfischer und ihre Kennung.
  /// Die Kennung Erwachsener ist Person.email.
  anmeldename       String?
  /// Argon2id.
  passwortHash      String?
  /// Verschluesselt mit TOTP_ENC_KEY; nur Erwachsene mit Rechten.
  totpGeheimnis     String?
  totpAktivAm       DateTime?
  /// Zeitpunkt der letzten erfolgreichen Anmeldung; null, solange noch nie angemeldet.
  letzteAnmeldungAm DateTime?
  angelegtAm        DateTime  @default(now())

  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]

  /// Ziel der zusammengesetzten Fremdschluessel von Passkey, RecoveryCode, Session.
  @@unique([vereinId, id])
  /// Prisma verlangt fuer die 1:1-Relation einen Schluessel genau ueber deren
  /// Felder; personId allein ist schon eindeutig.
  @@unique([vereinId, personId])
  @@unique([vereinId, anmeldename])
}

/// Ein Passkey (WebAuthn-Credential), Felder wie in hwyd. Gespeichert wird nur der
/// oeffentliche Schluessel; ein Datenbank-Leck gibt niemandem eine Anmeldung.
model Passkey {
  id           String    @id @default(cuid())
  vereinId     String
  verein       Verein    @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  zugangId     String
  zugang       Zugang    @relation(fields: [vereinId, zugangId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Credential-ID des Authenticators, base64url. Global eindeutig: Bei der
  /// Anmeldung ohne allowCredentials steht der Verein des Passkeys erst nach dem
  /// Nachschlagen fest ("Dieser Passkey gehoert nicht zu diesem Verein", Spec 4.3).
  credentialId String    @unique
  /// Oeffentlicher Schluessel (COSE), base64url.
  publicKey    String
  /// Signaturzaehler. Apple-Passkeys melden immer 0, weil ein synchronisierter
  /// Schluessel auf mehreren Geraeten liegt; 0 darf nie als Klon gelten.
  counter      Int       @default(0)
  /// z.B. ["internal", "hybrid"] — steuert, welche Wege der Browser anbietet.
  transports   String[]
  /// true bei synchronisierten Schluesseln, die den Verlust des Geraets ueberleben.
  backedUp     Boolean   @default(false)
  /// Name in den Einstellungen, aus dem User-Agent geraten ("iPhone", "Mac").
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([vereinId, zugangId])
}

/// Zehn gehashte Einmalcodes, nur fuer Zugaenge mit TOTP.
model RecoveryCode {
  id          String    @id @default(cuid())
  vereinId    String
  verein      Verein    @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  zugangId    String
  zugang      Zugang    @relation(fields: [vereinId, zugangId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  codeHash    String
  verwendetAm DateTime?

  /// Eindeutig je Zugang statt global wie in hwyd: Ein Code wird immer zu einem
  /// bekannten Zugang geprueft, und ein globaler Schluessel wuerde Zeilen
  /// verschiedener Vereine miteinander vergleichen.
  @@unique([zugangId, codeHash])
  @@index([vereinId, zugangId])
}

/// Einmal-Challenge einer WebAuthn-Zeremonie, wie in hwyd. Die Zeile wird beim
/// Einloesen geloescht, eine abgefangene Antwort ist danach wertlos.
///
/// vereinId null gehoert dem Plattform-Admin. Verworfen: eine zweite Tabelle fuer
/// Admin-Challenges — Challenges tragen keine Personendaten, eine Kopie braechte
/// nichts.
///
/// Der CHECK webauthn_challenge_besitzer (Migration mandantenschutz_nachgeschaerft)
/// haelt die beiden Arten auseinander: personId nur mit vereinId, adminId nur ohne.
/// Ohne ihn liesse der zusammengesetzte Fremdschluessel eine Zeile mit personId und
/// vereinId null ungeprueft durch (MATCH SIMPLE), und sie ueberlebte das Loeschen
/// des Vereins als scheinbare Admin-Zeile.
model WebauthnChallenge {
  id        String          @id @default(cuid())
  challenge String          @unique
  vereinId  String?
  verein    Verein?         @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  /// Fuer wen registriert wird (Einladung annehmen oder Passkey im Profil); bei
  /// der Anmeldung null, weil wer sich anmeldet erst nach der Antwort des
  /// Authenticators feststeht. Person statt Zugang, weil der Zugang beim
  /// Annehmen der Einladung erst mit dem ersten Passkey entsteht (Spec 4.2).
  personId  String?
  person    Person?         @relation(fields: [vereinId, personId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Gegenstueck zu personId fuer Admin-Challenges. Eine Zeile mit adminId hat
  /// nie eine vereinId (CHECK), verbindet also keine Vereinsdaten mit dem Admin.
  adminId   String?
  admin     PlattformAdmin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// 'register' oder 'authenticate'. Verhindert, dass eine Challenge aus der
  /// Einrichtung fuer eine Anmeldung eingetauscht wird.
  purpose   String
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([expiresAt])
}

/// Mitglieder-Sitzung: 90 Tage, verlaengert sich bei Nutzung (Spec 4.5). Nur der
/// Hash des Tokens steht hier, nie das Token selbst.
model Session {
  id             String   @id @default(cuid())
  vereinId       String
  verein         Verein   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  zugangId       String
  zugang         Zugang   @relation(fields: [vereinId, zugangId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  tokenHash      String   @unique
  ablauf         DateTime
  zuletztGesehen DateTime @default(now())
  userAgent      String?
  angelegtAm     DateTime @default(now())

  @@index([vereinId, zugangId])
}

/// Einladungs- und Reset-Link. Ein neuer Link macht den offenen alten derselben
/// Art fuer dieselbe Person ungueltig (Spec 3.4); das erledigt der Server.
model Einladung {
  id                  String       @id @default(cuid())
  vereinId            String
  verein              Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  personId            String
  person              Person       @relation("EinladungPerson", fields: [vereinId, personId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  art                 EinladungArt
  tokenHash           String       @unique
  ablauf              DateTime
  eingeloestAm        DateTime?
  /// null heisst "vom Plattform-Admin"; Einzelheiten stehen im AdminProtokoll.
  /// Verworfen: ein Verweis auf PlattformAdmin — dann waeren Vereinsdaten und
  /// Admin-Tabellen verbunden (Spec 3.2).
  ///
  /// NoAction statt Cascade: Einladungen, die eine spaeter entfernte Person
  /// erstellt hat, bleiben gueltig — entfernt wird ohnehin per Grabstein, nicht
  /// hart (Spec 5.8). Das Loeschen eines Vereins nimmt sie ueber die eigene
  /// Relation zum Verein mit (Begruendung bei Einwilligung).
  erstelltVonPersonId String?
  erstelltVon         Person?      @relation("EinladungErstelltVon", fields: [vereinId, erstelltVonPersonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  angelegtAm          DateTime     @default(now())

  @@index([vereinId, personId, art])
  @@index([vereinId, erstelltVonPersonId])
}

/// Einwilligungen werden nie geloescht, nur widerrufen; so bleibt nachweisbar,
/// wer wann eingewilligt hat. Beim Entfernen einer Person bleiben sie stehen.
model Einwilligung {
  id               String          @id @default(cuid())
  vereinId         String
  verein           Verein          @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  /// Beide Personen-Relationen ohne Kaskade: Das harte Loeschen einer Person mit
  /// Einwilligung wird abgelehnt (Nachweis, Spec 3.4). Das Loeschen eines ganzen
  /// Vereins geht trotzdem durch, weil Postgres die Pruefungen aus einer Kaskade
  /// erst am Ende der Anweisung ausfuehrt — dann hat die Kaskade vom Verein die
  /// Einwilligung schon entfernt (Test "Verein loeschen ...").
  ///
  /// NoAction statt Restrict: Ohne DEFERRABLE verhalten sich beide hier gleich
  /// (mit Postgres 17 nachgeprueft, auch das Vereinsloeschen mit RESTRICT). Die
  /// Befuerchtung, RESTRICT pruefe mitten in der Kaskade, traf nicht zu; NO ACTION
  /// liesse sich aber spaeter aufschieben, RESTRICT nie.
  jungfischerId    String
  jungfischer      Person          @relation("EinwilligungJungfischer", fields: [vereinId, jungfischerId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Person, die eingewilligt hat (erziehungsberechtigte Bezugsperson).
  erteiltVon       String
  erteiltVonPerson Person          @relation("EinwilligungErteiltVon", fields: [vereinId, erteiltVon], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  art              EinwilligungArt
  /// Fassung des Einwilligungstexts, der angezeigt wurde.
  textVersion      String
  erteiltAm        DateTime        @default(now())
  widerrufenAm     DateTime?

  @@index([vereinId, jungfischerId])
  @@index([vereinId, erteiltVon])
}

/// Ausgehende Mails. Gehoert schon in TP2: Der Reset-Dialog muss sofort antworten
/// koennen, ohne ueber die Antwortzeit zu verraten, ob es die Adresse gibt.
model MailWarteschlange {
  id               String    @id @default(cuid())
  /// null bei Mails ohne Verein (z.B. an den Plattform-Admin).
  vereinId         String?
  verein           Verein?   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  empfaenger       String
  betreff          String
  text             String
  versuche         Int       @default(0)
  naechsterVersuch DateTime  @default(now())
  gesendetAm       DateTime?
  fehler           String?
  /// Wozu die Mail gehoert, z.B. "einladung:<id>" — fuer den Warnhinweis
  /// "Einladungsmail nicht zustellbar" (Spec 5.3). Freitext statt Fremdschluessel,
  /// weil spaetere Teilprojekte weitere Anlaesse bringen.
  bezug            String?
  angelegtAm       DateTime  @default(now())

  @@index([gesendetAm, naechsterVersuch])
  @@index([vereinId, bezug])
}

// --- Threads (TP3, Spec Thread-Kern 2) -----------------------------------------
//
// Dieselbe Mandantentrennung wie oben: vereinId in jeder Tabelle, Verweise als
// zusammengesetzte Fremdschluessel mit onUpdate: NoAction. CHECKs und die
// Partial-Unique-Indizes stehen von Hand in der Migration threads.

/// Ein Thread ist Aushang, Kommentarbereich oder Chat (modus) und sammelt Module.
/// Zielgruppe sind rollenfilter und Untergruppen (ThreadUntergruppe).
model Thread {
  id                    String       @id @default(cuid())
  vereinId              String
  verein                Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  art                   ThreadArt    @default(NORMAL)
  /// 1-120 Zeichen ohne Rand (CHECK thread_titel).
  titel                 String
  modus                 ThreadModus
  rollenfilter          Rollenfilter
  /// true = "Alle"; sonst gelten die Eintraege in ThreadUntergruppe.
  alleUntergruppen      Boolean      @default(true)
  /// Oben in der Liste, nie automatisch archiviert.
  angepinnt             Boolean      @default(false)
  archivModus           ArchivModus  @default(AUTOMATISCH)
  /// null = Entwurf.
  veroeffentlichtAm     DateTime?
  /// null nur beim Austausch, den das System anlegt (CHECK thread_ersteller).
  /// NoAction statt Cascade: Entfernt wird eine Person per Grabstein, nicht hart
  /// (Spec 5.8); ihre Threads bleiben. Das Loeschen eines ganzen Vereins geht
  /// trotzdem durch (Begruendung bei Einwilligung).
  erstelltVonId         String?
  erstelltVon           Person?      @relation("ThreadErstelltVon", fields: [vereinId, erstelltVonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Zeitpunkt und Aenderungsstand der letzten Aktivitaet: Sortierung der Liste.
  /// Das Archiv folgt dem letzten Termin, nicht dieser Spalte (Spec 3.7). Als
  /// Spalten statt aus Verlauf und Modulen berechnet, weil die Liste sonst bei
  /// jedem Aufruf alle Threads eines Vereins durchsuchen muesste.
  letzteAktivitaetAm    DateTime     @default(now())
  letzteAktivitaetStand Int          @default(0)
  /// Stand des letzten Anlegens oder Speicherns im Editor; PUT schickt ihn als
  /// Version mit. Eigene Spalte statt geaendertAm, weil @updatedAt bei jeder
  /// Antwort springt und den offenen Editor jedes Mal veraltet machte.
  bearbeitetStand       Int          @default(0)
  angelegtAm            DateTime     @default(now())
  /// Technischer Zeitstempel: @updatedAt springt bei jedem updateMany aus
  /// mitAenderung (auch bei jeder Antwort und Nachricht) auf die Uhr des Prozesses.
  /// Nicht "Kopf geaendert" -- dafuer gelten Verlauf und Aenderung.
  geaendertAm           DateTime     @default(now()) @updatedAt

  untergruppen ThreadUntergruppe[]
  module       ThreadModul[]
  verlauf      VerlaufEintrag[]
  gelesen      GelesenStand[]

  /// Ziel der zusammengesetzten Fremdschluessel.
  @@unique([vereinId, id])
  @@index([vereinId, letzteAktivitaetAm])
}

/// Die Auswahl bei alleUntergruppen = false. Wird eine Untergruppe geloescht,
/// faellt sie per Cascade aus der Auswahl; bleibt keine uebrig, sieht nur noch,
/// wer Jugendleiter ist. Verworfen: das Loeschen der Untergruppe verweigern,
/// solange Threads sie nennen -- eine aufgeloeste Untergruppe haengte sonst an
/// alten, archivierten Threads.
model ThreadUntergruppe {
  vereinId      String
  verein        Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  threadId      String
  thread        Thread      @relation(fields: [vereinId, threadId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  untergruppeId String
  untergruppe   Untergruppe @relation(fields: [vereinId, untergruppeId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([threadId, untergruppeId])
  @@index([vereinId, untergruppeId])
}

/// Kopfzeile eines Moduls; je Typ haengt eine Tabelle mit derselben id daran
/// (InfoModul, TerminModul, UmfrageModul, HelferModul). Verworfen: ein JSON-Feld je Modul --
/// Regeln wie "eine Antwort pro Kind" sollen in der Datenbank abgesichert sein.
///
/// position ist nicht eindeutig: Beim Umsortieren in einer Transaktion verletzte
/// ein eindeutiger Index zeilenweise. Sortiert wird nach (position, id); den
/// Editor prueft die Domaene.
model ThreadModul {
  id       String   @id @default(cuid())
  vereinId String
  verein   Verein   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  threadId String
  thread   Thread   @relation(fields: [vereinId, threadId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  typ      ModulTyp
  /// Mindestens 0 (CHECK modul_position).
  position Int
  titel    String?

  info        InfoModul?
  termin      TerminModul?
  umfrage     UmfrageModul?
  dateienKopf DateienModul?
  fotosKopf   FotosModul?
  helfer      HelferModul?
  dateien     Datei[]

  @@unique([vereinId, id])
  /// Ziel des Fremdschluessels von UmfrageModul: So stimmt dessen threadId immer
  /// mit dem Thread des Moduls ueberein.
  @@unique([vereinId, id, threadId])
  @@index([vereinId, threadId])
}

model InfoModul {
  /// Dieselbe id wie das ThreadModul.
  id       String      @id
  vereinId String
  verein   Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modul    ThreadModul @relation(fields: [vereinId, id], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Markdown-Teilmenge, hoechstens 10000 Zeichen (CHECK info_text).
  text     String

  /// Prisma verlangt fuer die 1:1-Relation einen Schluessel genau ueber deren Felder.
  @@unique([vereinId, id])
}

/// Kopfzeile des Datei-Moduls. Sie traegt nichts ausser der Modul-ID; die Dateien
/// haengen ueber Datei.modulId am ThreadModul, nicht hieran. Verworfen: gar keine
/// Zeile, nur ModulTyp -- jedes Modul hat so dieselbe Form (Kopfzeile je Typ), und das
/// Datei-Modul bekommt einen Ort fuer spaetere Felder.
model DateienModul {
  /// Dieselbe id wie das ThreadModul.
  id       String      @id
  vereinId String
  verein   Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modul    ThreadModul @relation(fields: [vereinId, id], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vereinId, id])
}

/// Kopfzeile des Foto-Moduls. Die Fotos selbst sind Datei-Zeilen am ThreadModul.
model FotosModul {
  /// Dieselbe id wie das ThreadModul.
  id        String        @id
  vereinId  String
  verein    Verein        @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modul     ThreadModul   @relation(fields: [vereinId, id], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  hochladen FotoHochladen @default(JUGENDLEITER)

  @@unique([vereinId, id])
}

/// Datum und Uhrzeit sind Wandzeit in Europe/Berlin; der Verein hat kein
/// Zeitzonenfeld, solange alle Vereine in Deutschland sind. Verworfen:
/// Zeitpunkte (timestamptz) -- ein ganztaegiger Termin hat keinen Zeitpunkt, und
/// die Anzeige rechnete bei jeder Zeitumstellung um.
model TerminModul {
  id         String      @id
  vereinId   String
  verein     Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modul      ThreadModul @relation(fields: [vereinId, id], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  startDatum DateTime    @db.Date
  /// Nicht vor startDatum (CHECK termin_reihenfolge).
  endDatum   DateTime?   @db.Date
  /// HH:MM (CHECK termin_uhrzeit). Ein Ende ohne Beginn ist erlaubt ("bis 12:00").
  beginn     String?
  ende       String?
  ort        String?
  treffpunkt String?

  @@unique([vereinId, id])
  @@index([vereinId, startDatum])
}

/// Kopfzeile der Helferliste ("Wer bringt was mit?"): Positionen mit Plaetzen, in
/// die sich Personen eintragen. Eigene Tabellen statt UmfrageModul mit Optionen:
/// Eine Position hat eine Anzahl, und mehrere Personen teilen sie sich -- die
/// Umfrage kennt nur "gewaehlt oder nicht".
model HelferModul {
  /// Dieselbe id wie das ThreadModul.
  id       String         @id
  vereinId String
  verein   Verein         @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modul    ThreadModul    @relation(fields: [vereinId, id], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Wer eingetragen wird: wie bei der Umfrage der Jungfischer, der Erwachsene
  /// oder die Person. Nach dem ersten Eintrag nicht mehr aenderbar (Domaene).
  einheit  AntwortEinheit @default(ERWACHSENER)
  /// Ab jetzt >= frist ist die Frist abgelaufen; die Server-Uhr entscheidet.
  frist    DateTime?

  positionen HelferPosition[]

  /// Prisma verlangt fuer die 1:1-Relation einen Schluessel genau ueber deren Felder.
  @@unique([vereinId, id])
}

/// Eine Zeile der Helferliste, z. B. "Kuchen", 4 Plaetze.
model HelferPosition {
  id         String      @id @default(cuid())
  vereinId   String
  verein     Verein      @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  modulId    String
  modul      HelferModul @relation(fields: [vereinId, modulId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// 1-80 Zeichen (CHECK helfer_position_text).
  text       String
  /// Plaetze, 1-99 (CHECK helfer_position_anzahl).
  anzahl     Int
  /// Mindestens 0 (CHECK helfer_position_position); nicht eindeutig, wie bei ThreadModul.
  position   Int
  /// Bleibt beim Umbenennen und Umsortieren stabil, damit Eintraege an ihrer
  /// Position bleiben (CHECK helfer_position_schluessel).
  schluessel String

  eintraege HelferEintrag[]

  @@unique([modulId, schluessel])
  /// Ziel des Fremdschluessels von HelferEintrag: Ein Eintrag gehoert so zu einer
  /// Position desselben Vereins.
  @@unique([vereinId, id])
}

/// Eine Person in einer Position; ein neuer Eintrag derselben Person ueberschreibt
/// den alten (Upsert), wie bei UmfrageAntwort. Jeder Eintrag belegt einen Platz,
/// auch wenn die Person nicht mehr gefragt ist (Plan, Entscheidung 1).
///
/// Alle drei Relationen ohne Kaskade: Von Thread, Modul oder Helferliste fuehrt
/// kein Kaskadenweg zu den Eintraegen, jeder Eintrag haelt seine Position fest
/// (P2003) -- eine Liste mit Eintraegen verschwindet nie still. Verworfen: Cascade
/// an der Position; ein Thread mit Zusagen waere mit einem Klick samt allen
/// Zusagen weg. Der Editor lehnt das Entfernen vorher mit 409 ab. Das Loeschen
/// eines ganzen Vereins geht trotzdem durch, weil jede Tabelle direkt vom Verein
/// kaskadiert. Die Personen ohne Kaskade aus demselben Grund wie bei Einwilligung:
/// entfernt wird per Grabstein.
model HelferEintrag {
  id            String         @id @default(cuid())
  vereinId      String
  verein        Verein         @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  positionId    String
  position      HelferPosition @relation(fields: [vereinId, positionId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Wer hilft (Jungfischer oder Erwachsener).
  fuerId        String
  fuer          Person         @relation("HelferEintragFuer", fields: [vereinId, fuerId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Wer den Eintrag vorgenommen hat.
  vonId         String
  von           Person         @relation("HelferEintragVon", fields: [vereinId, vonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// 1-80 Zeichen oder null (CHECK helfer_eintrag_notiz); ein Leerstring ist keine Notiz.
  /// Der CHECK braucht kein btrim: pruefeNotiz (@jufi/domain) trimmt vorher und macht
  /// aus Leerem null, und die Route schreibt nur, was pruefeNotiz liefert. "   " kaeme
  /// also nur an der Domain vorbei (Demo, Handarbeit) in die Datenbank. Verworfen:
  /// btrim im CHECK wie bei umfrage_frage -- es schuetzte nur vor diesem Umweg, und die
  /// angewandte Migration laesst sich wegen ihrer Pruefsumme nicht mehr aendern.
  notiz         String?
  /// Bleibt beim Aendern der Notiz stehen: Die Reihenfolge in der Position ist die der Anmeldung.
  eingetragenAm DateTime
  /// Je Verein eindeutig: Macht die Anfrage wiederholbar, wenn die Outbox des
  /// Clients sie ein zweites Mal schickt.
  clientId      String

  @@unique([positionId, fuerId])
  @@unique([vereinId, clientId])
  @@index([vereinId, fuerId])
  @@index([vereinId, vonId])
}

model UmfrageModul {
  id         String         @id
  vereinId   String
  verein     Verein         @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  /// Traegt den Thread mit, damit ein Partial-Unique-Index hoechstens eine
  /// Teilnahme-Umfrage je Thread erlaubt (umfrage_eine_teilnahme, Migration threads).
  threadId   String
  modul      ThreadModul    @relation(fields: [vereinId, id, threadId], references: [vereinId, id, threadId], onDelete: Cascade, onUpdate: NoAction)
  /// 1-200 Zeichen nach Abzug des Rands (CHECK umfrage_frage).
  frage      String
  einheit    AntwortEinheit
  mehrfach   Boolean        @default(false)
  teilnahme  Boolean        @default(false)
  vielleicht Boolean        @default(true)
  /// Ab jetzt >= frist ist die Frist abgelaufen; die Server-Uhr entscheidet.
  frist      DateTime?
  ergebnisse ErgebnisSicht  @default(ALLE)

  optionen  UmfrageOption[]
  antworten UmfrageAntwort[]

  @@unique([vereinId, id])
  /// Prisma verlangt fuer die 1:1-Relation zum Modul einen Schluessel genau ueber
  /// deren Felder.
  @@unique([vereinId, id, threadId])
}

model UmfrageOption {
  id         String       @id @default(cuid())
  vereinId   String
  verein     Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  umfrageId  String
  umfrage    UmfrageModul @relation(fields: [vereinId, umfrageId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  /// 1-200 Zeichen nach Abzug des Rands (CHECK option_text).
  text       String
  /// Mindestens 0 (CHECK option_position); nicht eindeutig, wie bei ThreadModul.
  position   Int
  /// Bleibt beim Umbenennen und Umsortieren stabil, damit abgegebene Antworten an
  /// ihrer Option bleiben. Bei der Teilnahme-Umfrage fest: dabei, vielleicht,
  /// abgesagt (CHECK option_schluessel).
  schluessel String

  antworten UmfrageAntwortOption[]

  @@unique([umfrageId, schluessel])
  /// Ziel des Fremdschluessels von UmfrageAntwortOption: Eine Antwort kann nur
  /// Optionen ihrer eigenen Umfrage waehlen.
  @@unique([vereinId, umfrageId, id])
}

/// Eine Antwort je Person und Umfrage; eine neue ueberschreibt die alte (Upsert).
/// Verworfen: jede Antwort als neue Zeile -- niemand braucht frueher abgegebene,
/// und "wer hat noch nicht geantwortet" wuerde zur Gruppierung.
///
/// Beide Personen-Relationen ohne Kaskade (Begruendung bei Einwilligung): Das
/// harte Loeschen einer Person mit Antwort wird abgelehnt; entfernt wird per
/// Grabstein.
model UmfrageAntwort {
  id          String       @id @default(cuid())
  vereinId    String
  verein      Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  umfrageId   String
  /// NoAction statt Cascade: Von Thread, Modul oder Umfrage fuehrt kein Kaskadenweg
  /// zu den Antworten, jede Antwort haelt ihre Umfrage fest (P2003) -- auch eine
  /// ohne gewaehlte Option. Gewollt: Antworten gehen nie still verloren (Spec 3.14).
  /// Verworfen: Cascade hier und die Sperre allein ueber UmfrageAntwortOption.option --
  /// ob dann zuerst die Option (Fehler) oder die Antwort (still weg) kaskadiert,
  /// haengt von der Reihenfolge der Prueftrigger in Postgres ab, und die kippt, wenn
  /// eine spaetere Migration einen der Fremdschluessel neu anlegt. Das Loeschen eines
  /// ganzen Vereins geht trotzdem durch, weil jede Tabelle direkt vom Verein kaskadiert.
  umfrage     UmfrageModul @relation(fields: [vereinId, umfrageId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Fuer wen geantwortet wird (Jungfischer oder Erwachsener).
  fuerId      String
  fuer        Person       @relation("AntwortFuer", fields: [vereinId, fuerId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Wer die Antwort abgegeben hat.
  vonId       String
  von         Person       @relation("AntwortVon", fields: [vereinId, vonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  abgegebenAm DateTime
  /// Je Verein eindeutig: Macht die Anfrage wiederholbar, wenn die Outbox des
  /// Clients sie ein zweites Mal schickt.
  clientId    String

  optionen UmfrageAntwortOption[]

  @@unique([umfrageId, fuerId])
  @@unique([vereinId, clientId])
  /// Ziel des Fremdschluessels von UmfrageAntwortOption.
  @@unique([vereinId, umfrageId, id])
  @@index([vereinId, fuerId])
  @@index([vereinId, vonId])
}

/// Die gewaehlten Optionen einer Antwort. umfrageId steht mit, damit beide
/// Fremdschluessel dieselbe Umfrage erzwingen.
model UmfrageAntwortOption {
  vereinId  String
  verein    Verein         @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  umfrageId String
  antwortId String
  antwort   UmfrageAntwort @relation(fields: [vereinId, umfrageId, antwortId], references: [vereinId, umfrageId, id], onDelete: Cascade, onUpdate: NoAction)
  optionId  String
  /// NoAction statt Cascade: Eine gewaehlte Option laesst sich nicht loeschen
  /// (P2003), solange eine Antwort sie nennt. Gewollt: Antworten gehen nie still
  /// verloren (Spec 3.14). Das Verschwinden beantworteter Umfragen, Module und
  /// Threads sperrt UmfrageAntwort.umfrage, ebenfalls NoAction -- dieser Riegel
  /// haengt also nicht an der Reihenfolge der Kaskaden. Threads loescht man nur
  /// ohne Antworten (Spec 3.5). Verworfen: DEFERRABLE INITIALLY DEFERRED -- die
  /// Pruefung liefe nach der Kaskade, und das Loeschen verwuerfe beantwortete
  /// Umfragen kommentarlos.
  option    UmfrageOption  @relation(fields: [vereinId, umfrageId, optionId], references: [vereinId, umfrageId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([antwortId, optionId])
}

/// Nachrichten und Systemeintraege eines Threads. Loeschen leert den Text und
/// setzt geloeschtAm/geloeschtVonId; die Zeile bleibt ("Nachricht geloescht").
/// Die CHECKs verlauf_* halten die beiden Arten auseinander.
model VerlaufEintrag {
  id             String     @id @default(cuid())
  vereinId       String
  verein         Verein     @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  threadId       String
  thread         Thread     @relation(fields: [vereinId, threadId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  art            VerlaufArt
  /// Bei Nachrichten der Verfasser, bei Systemeintraegen die handelnde Person.
  /// Ohne Kaskade: entfernt wird per Grabstein.
  autorId        String?
  autor          Person?    @relation("VerlaufAutor", fields: [vereinId, autorId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// 1-2000 Zeichen Klartext (CHECK verlauf_text); null bei Systemeintraegen und
  /// geloeschten Nachrichten.
  text           String?
  systemArt      SystemArt?
  /// Kleines JSON mit den Angaben fuer den Satz des Systemeintrags.
  systemDaten    Json?
  /// Aenderungsstand beim Anlegen; traegt Zaehler und "Neu".
  stand          Int
  angelegtAm     DateTime   @default(now())
  geloeschtAm    DateTime?
  geloeschtVonId String?
  geloeschtVon   Person?    @relation("VerlaufGeloeschtVon", fields: [vereinId, geloeschtVonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Je Verein eindeutig, macht das Senden wiederholbar; null bei Systemeintraegen.
  clientId       String?

  @@unique([vereinId, clientId])
  @@index([vereinId, threadId, stand])
}

/// Bis wohin eine Person einen Thread gesehen hat. Zwei Staende, damit der Zaehler
/// am Reiter "Verlauf" nicht verschwindet, nur weil jemand die Uebersicht geoeffnet
/// hat. Verworfen: Lesestand im Browser -- auf jedem Geraet waere alles wieder
/// neu, und nach dem Abmelden ginge er verloren.
model GelesenStand {
  vereinId          String
  verein            Verein   @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  personId          String
  person            Person   @relation(fields: [vereinId, personId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  threadId          String
  thread            Thread   @relation(fields: [vereinId, threadId], references: [vereinId, id], onDelete: Cascade, onUpdate: NoAction)
  gelesenBis        Int
  verlaufGelesenBis Int
  gelesenAm         DateTime

  @@id([personId, threadId])
  @@index([vereinId, threadId])
}

/// Protokoll der Aenderungen im Verein (nur Kennungen, keine Inhalte), aus dem
/// ein Client mit "seit Stand n" nachlaedt. Eine Zeile je betroffenem Objekt;
/// mehrere teilen sich den Stand ihrer Transaktion, darum eine eigene id und ein
/// Index auf (vereinId, stand) statt eines eindeutigen Paars.
///
/// threadId, objektId und urheberId ohne Fremdschluessel: Das Loeschen eines
/// Threads oder einer Person muss als Aenderung erhalten bleiben, sonst erfuehre
/// ein Client nie davon. Eintraege aelter als 90 Tage raeumt der App-Prozess auf.
model Aenderung {
  id         String       @id @default(cuid())
  vereinId   String
  verein     Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  stand      Int
  threadId   String?
  art        AenderungArt
  objektId   String
  urheberId  String?
  angelegtAm DateTime     @default(now())

  @@index([vereinId, stand])
  @@index([vereinId, threadId, stand])
  @@index([angelegtAm])
}

// --- Plattform-Admin ----------------------------------------------------------
//
// Eigene Tabellen ohne vereinId und ohne Verbindung zu den Personen (Spec 3.2).
// Verworfen: der Admin als Zugang ohne Person — dann stuende er in denselben
// Tabellen wie die Vereinsdaten, und die Trennung hinge wieder an Abfragen.

model PlattformAdmin {
  id            String    @id @default(cuid())
  benutzername  String    @unique
  /// Leer bis zur Einrichtung ueber den einmaligen Link aus der Kommandozeile.
  passwortHash  String?
  /// Verschluesselt mit TOTP_ENC_KEY.
  totpGeheimnis String?
  totpAktivAm   DateTime?
  angelegtAm    DateTime  @default(now())

  sessions           AdminSession[]
  passkeys           AdminPasskey[]
  recoveryCodes      AdminRecoveryCode[]
  einrichtungen      AdminEinrichtung[]
  protokoll          AdminProtokoll[]
  webauthnChallenges WebauthnChallenge[]
}

/// 12 Stunden, ohne Verlaengerung (Spec 4.5).
model AdminSession {
  id         String         @id @default(cuid())
  adminId    String
  admin      PlattformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique
  ablauf     DateTime
  userAgent  String?
  angelegtAm DateTime       @default(now())

  @@index([adminId])
}

/// Wie Passkey, aber nur fuer den Admin; ein Vereins-Passkey wird bei der
/// Admin-Anmeldung nicht erkannt (Spec 7.2).
model AdminPasskey {
  id           String         @id @default(cuid())
  adminId      String
  admin        PlattformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  credentialId String         @unique
  publicKey    String
  counter      Int            @default(0)
  transports   String[]
  backedUp     Boolean        @default(false)
  label        String
  createdAt    DateTime       @default(now())
  lastUsedAt   DateTime?

  @@index([adminId])
}

model AdminRecoveryCode {
  id          String         @id @default(cuid())
  adminId     String
  admin       PlattformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash    String
  verwendetAm DateTime?

  @@unique([adminId, codeHash])
}

/// Einmaliger Einrichtungslink aus "admin anlegen" bzw. "admin zuruecksetzen",
/// 1 Stunde gueltig (Spec 7.1).
model AdminEinrichtung {
  id           String         @id @default(cuid())
  adminId      String
  admin        PlattformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash    String         @unique
  ablauf       DateTime
  eingeloestAm DateTime?
  angelegtAm   DateTime       @default(now())

  @@index([adminId])
}

/// Wer wann was an einem Verein getan hat (Spec 7.5): Als Auftragsverarbeiter muss
/// die Plattform das belegen koennen.
model AdminProtokoll {
  id                 String         @id @default(cuid())
  /// Restrict: Ein Admin mit Protokolleintraegen laesst sich nicht hart loeschen,
  /// sonst verloere der Nachweis seinen Urheber.
  adminId            String
  admin              PlattformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  zeitpunkt          DateTime       @default(now())
  aktion             AdminAktion
  /// Ohne Fremdschluessel: Das Protokoll ueberlebt das Loeschen eines Vereins.
  /// Der Slug steht deshalb als Abschrift daneben.
  vereinId           String
  vereinSlug         String
  /// z.B. Ziel eines Notfall-Links. Ebenfalls ohne Fremdschluessel — sonst waeren
  /// Admin-Tabellen und Personen verbunden (Spec 3.2).
  betroffenePersonId String?

  @@index([vereinId, zeitpunkt])
}

// --- Dateien und Dokumente (TP4) ------------------------------------------------

enum DateiArt {
  FOTO
  DATEI
}

/// Metadaten einer abgelegten Datei; die Bytes liegen im Volume, der Schluessel dort
/// haengt an der id und nie am Namen. Gehoert entweder zu einem Modul oder zu einem
/// Dokument, nie zu beidem und nie zu keinem (CHECK datei_ein_verweis).
///
/// NoAction statt Cascade zu Modul und Dokument: Ein Kaskadenloeschen umginge die
/// Loeschliste (DateiLoeschung), und die Bytes blieben bis zum Waisen-Schritt liegen.
/// So muss jeder Loeschpfad die Dateien ausdruecklich freigeben.
model Datei {
  id            String       @id @default(cuid())
  vereinId      String
  /// Kaskade ist hier Absicht und die einzige Ausnahme von "Dateien nie per Kaskade loeschen": Wird ein
  /// ganzer Verein geloescht, fallen die Zeilen mit; die Bytes ohne Zeile raeumt der Waisen-Schritt des
  /// Aufraeumers weg, sobald sie aelter als 24 Stunden sind (TP4-Spec 2.7). Eine Wiederherstellung braucht dann auch das Volume.
  verein        Verein       @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  art           DateiArt
  modulId       String?
  modul         ThreadModul? @relation(fields: [vereinId, modulId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  dokumentId    String?
  dokument      Dokument?    @relation(fields: [vereinId, dokumentId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Urspruenglicher Dateiname, bereinigt (CHECK datei_name). Bei Fotos darf er leer sein.
  name          String       @default("")
  /// Am Inhalt erkannter Typ, nie der vom Absender behauptete.
  typ           String
  groesse       Int
  /// Nur Fotos.
  breite        Int?
  hoehe         Int?
  sha256        String
  vonId         String
  von           Person       @relation("DateiVon", fields: [vereinId, vonId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  hochgeladenAm DateTime

  @@unique([vereinId, id])
  @@index([vereinId])
}

model DokumentKategorie {
  id       String @id @default(cuid())
  vereinId String
  verein   Verein @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  name     String
  /// Handreihenfolge, mindestens 0 (CHECK kategorie_position).
  position Int

  dokumente Dokument[]

  @@unique([vereinId, name])
  @@unique([vereinId, id])
}

model Dokument {
  id          String            @id @default(cuid())
  vereinId    String
  verein      Verein            @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  kategorieId String
  kategorie   DokumentKategorie @relation(fields: [vereinId, kategorieId], references: [vereinId, id], onDelete: NoAction, onUpdate: NoAction)
  titel       String
  angelegtAm  DateTime

  dateien Datei[]

  @@unique([vereinId, id])
}

/// Liste der Bytes, die nach dem Loeschen einer Datei noch auf der Platte liegen und
/// nach 24 Stunden verschwinden (Spec 2.7). Ohne Relation: Die Zeile ueberlebt Datei
/// und Verein. Mit vereinId, damit ein Vereins-Pfad sie ueber vereinDb schreiben darf.
model DateiLoeschung {
  schluessel  String   @id
  vereinId    String
  geloeschtAm DateTime

  @@index([geloeschtAm])
}
